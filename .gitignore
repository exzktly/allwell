# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
dist/
build/
*.egg-info/

# PyInstaller
*.spec.bak

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Local test run logs (not for commit)
_pytest*.log

# Coverage data
.coverage
# Parallel-mode data files, one per test process — scripts/coverage.sh combines
# them. Without this they are untracked leftovers that preflight's tree check
# fails on, and that `git add -A` would sweep into a commit.
.coverage.*
coverage.xml
htmlcov/

# CI fast-lane JUnit report (gates on this instead of the segfault-prone exit code)
.pytest-report.xml
.mplcache/
.pytest-slow-reports/

# Slow-lane JUnit reports under a SLOW_REPORT_DIR override — scripts/test_slow.sh
# takes the directory from the environment, so a hand-run sweep lands outside the
# default above and would otherwise show up as untracked.
.slow-*/

# Generated by tests/visual/render_views.py — regenerate, do not commit.
_Docs/visual_audit/screenshots/

# Session status doc — kept out of the repo per CLAUDE.md §5
PERF_STATUS.md
